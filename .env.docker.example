# Copy to the ignored .env.docker used by docker-compose.build.yml.
# Keep the resulting .env.docker server-side and preserve the generated key between restarts.

# Set the same encryption key used by the deployment.
ENCRYPTION_SECRET=
DATABASE_URL=postgresql://postgres:typebot@typebot-db-docker:5432/typebot
NEXTAUTH_URL=
NEXT_PUBLIC_VIEWER_URL=

# Required by the Viewer Host Bridge; unique random value, at least 32 bytes.
HOST_SESSION_BINDING_KEY=

# Other Host integration values are configured by the deployment as needed.
HOST_BRIDGE_SERVICE_KEY=
HOST_EXECUTION_CONTEXT_SIGNING_KEY=
HOST_API_BASE_URL=
HOST_SERVICE_AUTH_KEY=
