{
  "name": "@typebot.io/scripts",
  "scripts": {
    "start": "SKIP_ENV_CHECK=true dotenv -e ./.env.local -- tsx --tsconfig ./tsconfig.json src/main.ts",
    "start:prod": "bun run run:prod:mysql src/main.ts",
    "run:prod:mysql": "cd ../prisma && bun db:generate:mysql && cd ../scripts && SKIP_ENV_CHECK=true dotenv --override -e ./.env.production -- tsx --tsconfig ./tsconfig.json",
    "db:backup": "tsx --tsconfig ./tsconfig.json src/backupDatabase.ts",
    "db:restore": "tsx --tsconfig ./tsconfig.json src/restoreDatabase.ts",
    "db:setCustomPlan": "bun run run:prod:mysql src/setCustomPlan.ts",
    "db:bulkUpdate": "bun run run:prod:mysql src/bulkUpdate.ts",
    "db:fixTypebots": "bun run run:prod:mysql src/fixTypebots.ts",
    "inspectUser": "bun run run:prod:mysql src/inspectUser.ts",
    "checkSubscriptionsStatus": "bun run run:prod:mysql src/checkSubscriptionsStatus.ts",
    "createChatsPrices": "bun run run:prod:mysql src/createChatsPrices.ts",
    "migrateSubscriptionsToUsageBased": "bun run run:prod:mysql src/migrateSubscriptionsToUsageBased.ts",
    "insertUsersInBrevoList": "bun run run:prod:mysql src/insertUsersInBrevoList.ts",
    "getUsage": "bun run run:prod:mysql src/getUsage.ts",
    "blockTypebot": "bun run run:prod:mysql src/blockTypebot.ts",
    "suspendWorkspace": "bun run run:prod:mysql src/suspendWorkspace.ts",
    "destroyUser": "bun run run:prod:mysql src/destroyUser.ts",
    "updateTypebot": "bun run run:prod:mysql src/updateTypebot.ts",
    "updateWorkspace": "bun run run:prod:mysql src/updateWorkspace.ts",
    "inspectTypebot": "bun run run:prod:mysql src/inspectTypebot.ts",
    "inspectPublishedTypebot": "bun run run:prod:mysql src/inspectPublishedTypebot.ts",
    "inspectWorkspace": "bun run run:prod:mysql src/inspectWorkspace.ts",
    "getCoupon": "bun run run:prod:mysql src/getCoupon.ts",
    "redeemCoupon": "bun run run:prod:mysql src/redeemCoupon.ts",
    "exportResults": "bun run run:prod:mysql src/exportResults.ts",
    "updateUserEmail": "bun run run:prod:mysql src/updateUserEmail.ts",
    "updateWhatsAppStatusForwardUrl": "bun run run:prod:mysql src/updateWhatsAppStatusForwardUrl.ts",
    "inspectChatSession": "bun run run:prod:mysql src/inspectChatSession.ts",
    "searchResult": "bun run run:prod:mysql src/searchResult.ts",
    "inspectResult": "bun run run:prod:mysql src/inspectResult.ts",
    "inspectCredentials": "bun run run:prod:mysql src/inspectCredentials.ts",
    "deleteChatSession": "bun run run:prod:mysql src/deleteChatSession.ts",
    "sendEmailCampaign": "bun run run:prod:mysql src/sendEmailCampaign.ts",
    "checkDependencies": "tsx --tsconfig ./tsconfig.json src/checkDependencies.ts",
    "readCsvAndDoSomething": "bun run run:prod:mysql src/readCsvAndDoSomething.ts",
    "recurringCheckInactiveUsers": "bun run run:prod:mysql src/recurringCheckInactiveUsers.ts",
    "addHttpProxyCredentials": "bun run run:prod:mysql src/addHttpProxyCredentials.ts",
    "deleteS3Object": "bun run run:prod:mysql src/deleteS3Object.ts",
    "cron:hourly": "SKIP_ENV_CHECK=true tsx --tsconfig ./tsconfig.json src/cronJobs/hourly.tsx",
    "cron:daily": "SKIP_ENV_CHECK=true tsx --tsconfig ./tsconfig.json src/cronJobs/daily.tsx",
    "cron:monthly": "SKIP_ENV_CHECK=true tsx --tsconfig ./tsconfig.json src/cronJobs/monthly.tsx",
    "generateWorkspaceSummary": "bun run run:prod:mysql src/generateWorkspaceSummary.ts"
  },
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "import": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.106",
    "ky": "^1.2.4",
    "@clack/prompts": "^0.11.0",
    "@paralleldrive/cuid2": "^2.2.1",
    "@typebot.io/billing": "workspace:*",
    "@typebot.io/results": "workspace:*",
    "@typebot.io/telemetry": "workspace:*",
    "cli-progress": "^3.12.0",
    "papaparse": "^5.4.1",
    "@typebot.io/lib": "workspace:*",
    "@typebot.io/prisma": "workspace:*",
    "posthog-node": "^5.8.2",
    "prompts": "^2.4.2",
    "stripe": "17.1.0",
    "@typebot.io/workspaces": "workspace:*",
    "@typebot.io/typebot": "workspace:*",
    "@typebot.io/emails": "workspace:*",
    "@typebot.io/env": "workspace:*",
    "@typebot.io/blocks-bubbles": "workspace:*",
    "@typebot.io/blocks-core": "workspace:*",
    "@typebot.io/groups": "workspace:*",
    "@typebot.io/rich-text": "workspace:*",
    "ai": "^5.0.52",
    "p-limit": "^7.2.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/cli-progress": "^3.11.5",
    "@types/papaparse": "^5.3.7",
    "@types/prompts": "^2.4.4",
    "tsx": "^4.19.1",
    "@typebot.io/blocks-integrations": "workspace:*",
    "dotenv": "^16.4.5"
  }
}
