{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Keeps the Worker, class and binding names created by `partykit deploy`, so
  // existing rooms resolve to the same Durable Objects and their storage.
  "name": "typebot",
  "main": "src/webhookServer.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "PARTYKIT_DURABLE", "class_name": "PartyKitDurable" }
    ]
  },
  "exports": {
    "PartyKitDurable": { "type": "durable-object", "storage": "sqlite" }
  },
  // Keeps variables set outside this file, such as those from `partykit env`.
  "keep_vars": true,
  "dev": { "port": 1999 },
  "env": {
    // For a Worker first deployed with `partykit deploy`, which created the
    // class with the key-value backend. A class can't change its backend.
    "partykit": {
      "name": "typebot",
      "durable_objects": {
        "bindings": [
          { "name": "PARTYKIT_DURABLE", "class_name": "PartyKitDurable" }
        ]
      },
      "exports": {
        "PartyKitDurable": { "type": "durable-object", "storage": "legacy-kv" }
      }
    }
  }
}
